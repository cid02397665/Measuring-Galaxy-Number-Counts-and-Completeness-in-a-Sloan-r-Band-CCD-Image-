'''
Cosmic variance and testing uniformity
'''

if len(cat_tab) and 'xcentroid' in cat_tab.colnames and 'ycentroid' in cat_tab.colnames:
    print("===== Counts-in-cells variance analysis =====")

    # number of segments in x and y (can adjust)
    N_XSEG, N_YSEG = 2, 3

    dx = nx / N_XSEG
    dy = ny / N_YSEG

    x = np.array(cat_tab['xcentroid'], dtype=float)
    y = np.array(cat_tab['ycentroid'], dtype=float)

    # map each source to a cell index (ix, iy)
    ix = np.clip((x / dx).astype(int), 0, N_XSEG - 1)
    iy = np.clip((y / dy).astype(int), 0, N_YSEG - 1)

    N_cells = np.zeros((N_YSEG, N_XSEG), dtype=int)
    for j_cell, i_cell in zip(iy, ix):
        N_cells[j_cell, i_cell] += 1

    cell_counts = []
    valid_cells = []
    for j in range(N_YSEG):
        y0 = int(j * dy)
        y1 = int((j + 1) * dy)
        y1c = min(y1, ny)
        for i in range(N_XSEG):
            x0 = int(i * dx)
            x1 = int((i + 1) * dx)
            x1c = min(x1, nx)

            submask = badmask[y0:y1c, x0:x1c]
            if submask.size == 0:
                continue

            good_frac = 1.0 - submask.mean()  # fraction of unmasked pixels
            # require that at least half the cell is usable
            if good_frac < 0.5:
                continue

            cell_counts.append(N_cells[j, i])
            valid_cells.append((j, i, good_frac))

    cell_counts = np.array(cell_counts, dtype=float)
    k = len(cell_counts)

    if k < 2:
        print("Not enough valid cells for variance analysis (k < 2).")
    else:
        N_bar = cell_counts.mean()
        sigma_obs = cell_counts.std(ddof=1)
        sigma_exp = np.sqrt(N_bar)
        ratio = sigma_obs / sigma_exp if sigma_exp > 0 else np.nan

        print(f"Using {k} valid cells out of {N_XSEG * N_YSEG}")
        print(f"Mean count per cell N̄             = {N_bar:.3f}")
        print(f"Observed std σ_obs                 = {sigma_obs:.3f}")
        print(f"Poisson expected std √N̄           = {sigma_exp:.3f}")
        print(f"Ratio σ_obs / √N̄                  = {ratio:.3f}")


        try:
            from scipy import stats

            if N_bar > 0:
                chi2 = (k - 1) * (sigma_obs ** 2) / N_bar
                p_value = stats.chi2.sf(chi2, k - 1)
                print(f"Chi² = {chi2:.3f} for {k-1} dof, p-value = {p_value:.3g}")
                if p_value < 0.05:
                    print("→ Variance is significantly larger than Poisson expectation "
                          "(evidence for non-uniform / clustered distribution).")
                else:
                    print("→ Variance is consistent with Poisson expectation "
                          "within statistical uncertainties.")
            else:
                print("Mean count per cell is zero or negative; cannot perform chi-square test.")
        except ImportError:
            print("scipy not available; skipping formal chi-square test.")
else:
    print("No catalog / centroids available; skipping variance analysis.")
