#   Variable Aperture Photometry

    if len(cat_tab) and 'xcentroid' in cat_tab.colnames and 'ycentroid' in cat_tab.colnames:
        if 'kron_radius' in cat_tab.colnames:
            aper_r = np.array(cat_tab['kron_radius'], dtype=float)
        else:
            aper_r = np.sqrt(np.array(cat_tab['area'], dtype=float) / np.pi)

        xcen = np.array(cat_tab['xcentroid'], dtype=float)
        ycen = np.array(cat_tab['ycentroid'], dtype=float)

        aper_sum = []
        aper_area = []
        bkg_median = []
        bkg_std = []

        for x, y, r in zip(xcen, ycen, aper_r):
            r = float(r)
            if not np.isfinite(r) or r <= 0:
                aper_sum.append(0.0)
                aper_area.append(0.0)
                bkg_median.append(0.0)
                bkg_std.append(0.0)
                continue

            aper_i = CircularAperture((x, y), r=r)
            ann_i = CircularAnnulus((x, y), r_in=1.5 * r, r_out=2.5 * r)

            phot_i = aperture_photometry(data, [aper_i, ann_i])
            aper_sum.append(phot_i['aperture_sum_0'][0])
            aper_area.append(aper_i.area)

            ann_mask = ann_i.to_mask(method='center')
            ann_data = ann_mask.multiply(data)
            ann_data_1d = ann_data[ann_mask.data > 0]
            if len(ann_data_1d) > 0:
                _, med, std = sigma_clipped_stats(ann_data_1d, sigma=3.0, maxiters=5)
            else:
                med, std = 0.0, 0.0
            bkg_median.append(med)
            bkg_std.append(std)

        aper_sum = np.array(aper_sum)
        aper_area = np.array(aper_area)
        bkg_median = np.array(bkg_median)
        bkg_std = np.array(bkg_std)

        bkg_total = bkg_median * aper_area
        flux_net = aper_sum - bkg_total  # ADU

        var_e = np.clip(aper_sum, 0, None) * GAIN + aper_area * (bkg_std * GAIN) ** 2
        sigma_flux_e = np.sqrt(var_e)

        flux_net_e = flux_net * GAIN
        flux_rate_e = flux_net_e / EXPTIME
        sigma_flux_rate_e = sigma_flux_e / EXPTIME

        mag_ap_inst = np.full(len(cat_tab), np.nan)
        mag_ap_err_meas = np.full(len(cat_tab), np.nan)

        good_flux = (flux_rate_e > 0) & np.isfinite(sigma_flux_rate_e) & (sigma_flux_rate_e > 0)
        snr = np.zeros_like(flux_rate_e)
        snr[good_flux] = flux_rate_e[good_flux] / sigma_flux_rate_e[good_flux]

        SNR_MIN = 3.0
        good = good_flux & (snr >= SNR_MIN)

        mag_ap_inst[good] = -2.5 * np.log10(flux_rate_e[good])
        mag_ap_err_meas[good] = 1.0857 / snr[good]

        mag_ap_cal = ZP + mag_ap_inst
        mag_ap_cal_err = np.sqrt(mag_ap_err_meas ** 2 + ZP_err ** 2)

        cat_tab['aper_sum'] = aper_sum
        cat_tab['aper_area'] = aper_area
        cat_tab['bkg_median'] = bkg_median
        cat_tab['bkg_std'] = bkg_std
        cat_tab['bkg_total'] = bkg_total
        cat_tab['flux_ap_net'] = flux_net
        cat_tab['mag_ap_inst'] = mag_ap_inst
        cat_tab['mag_ap_cal'] = mag_ap_cal
        cat_tab['mag_ap_cal_err'] = mag_ap_cal_err
        cat_tab['mag_ap_err_meas'] = mag_ap_err_meas

'''
Removing objects above saturation threshold
'''

if len(cat_tab):
    threshold = hdr.get('SATURATE')

    remove_ids = []

    print(f"\nChecking for objects with pixels > {threshold} ...")
    for row in cat_tab:
        obj_id = row['id']
        mask_seg = (seg.data == obj_id)
        if not np.any(mask_seg):
            continue

        vals = data[mask_seg]
        max_val = vals.max()
        if max_val > threshold:
            coords = np.argwhere(mask_seg)
            idx_max = np.argmax(vals)
            y_max, x_max = coords[idx_max]
            print(
                f"Removing id={obj_id}: max pixel={max_val:.1f} "
                f"at (x={x_max}, y={y_max})"
            )
            remove_ids.append(obj_id)

    if remove_ids:
        keep = ~np.in1d(cat_tab['id'], remove_ids)
        cat_tab = cat_tab[keep]
        print(f"Removed {len(remove_ids)} objects with pixels > {threshold}.")
    else:
        print("No objects exceeded the pixel threshold.")

