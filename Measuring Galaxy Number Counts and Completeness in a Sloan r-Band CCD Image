def add_triangle_mask(badmask, x_start, x_end, y_bottom, y_top):
    ny, nx = badmask.shape
    x_center = 0.5 * (x_start + x_end)
    half_width_bottom = 0.5 * (x_end - x_start)
    for y in range(y_bottom, y_top + 1):
        t = (y - y_bottom) / (y_top - y_bottom)
        half_width_y = half_width_bottom * (1 - t)
        x_left = int(np.round(x_center - half_width_y))
        x_right = int(np.round(x_center + half_width_y))
        x_left = max(x_left, 0)
        x_right = min(x_right, nx - 1)
        badmask[y, x_left:x_right + 1] = True
    return badmask

def add_circle_mask(badmask, centre, radius):
    ny, nx = badmask.shape
    y, x = np.ogrid[:ny, :nx]
    cx, cy = centre
    circle = (x - cx) ** 2 + (y - cy) ** 2 <= radius ** 2
    badmask[circle] = True
    return badmask

def add_rectangle_mask(badmask, x_min, x_max, y_min, y_max):
    badmask[y_min:y_max, x_min:x_max] = True
    return badmask

